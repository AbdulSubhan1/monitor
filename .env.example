# Neon Postgres. Leave empty locally: an embedded Postgres (PGlite) in ./.pglite is used instead.
DATABASE_URL=
# Shared with the GitHub Actions secret of the same name; the uptime schedule sends it.
CRON_SECRET=
# Signs each project's log token (npm run -s log-token -- <project>).
LOG_SIGNING_SECRET=
# Password for /logs (Basic auth). Locally, when empty, /logs is open.
DASHBOARD_PASSWORD=
# Optional: a Vercel token so the dashboard can show each Vercel project's last deploy.
VERCEL_TOKEN=
